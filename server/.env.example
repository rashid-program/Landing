# Server
NODE_ENV=development
HOST=127.0.0.1
PORT=3008
PUBLIC_ORIGIN=http://127.0.0.1:3008

# Set true only when the app is behind one trusted reverse proxy.
TRUST_PROXY=false

# Lead collection remains disabled until every primary-storage value is valid.
# The primary webhook must persist the record in Russia and respond with:
# {"persisted": true}
PRIMARY_LEAD_WEBHOOK_URL=
PRIMARY_LEAD_WEBHOOK_TOKEN=
PRIMARY_DATA_REGION=RU
PRIMARY_STORAGE_CONFIRMED=false

# Public/legal identifier of the data operator, not a password.
DATA_OPERATOR_ID=

# Exact immutable version shown on consent.html, e.g. 2026-08-01-v1.
CONSENT_VERSION=

# Optional notification after Russian storage confirms persistence.
# Telegram receives only the random request ID, never name or phone.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Токен доступа к панели статистики /stats. Пока пуст — панель отдаёт 404.
STATS_TOKEN=
